    agent any
    stages {
        stage('BUILD') {
            steps {
                echo 'Building...'
            }
            }
            stage('TEST') {
                steps {
                    echo 'testing..'
                }
                }
                stage('DEPLOY') {
                    steps {
                        echo 'deploy..'
                    }
                }
            }
        }
